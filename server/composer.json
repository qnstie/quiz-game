{
  "name": "family-quiz/server",
  "description": "Family Quiz API (PHP 8.3 / Slim 4)",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "endroid/qr-code": "^5.0",
    "ezyang/htmlpurifier": "^4.17",
    "firebase/php-jwt": "^7.0",
    "monolog/monolog": "^3.5",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "FamilyQuiz\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FamilyQuiz\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --memory-limit=512M"
  },
  "config": {
    "sort-packages": true
  }
}
